# Copy this file to .env. Never commit .env or real API keys.
# Local-first course defaults
FINAI_MODEL_PROVIDER=ollama
FINAI_CHAT_MODEL=qwen3:8b
FINAI_EMBEDDING_PROVIDER=ollama
FINAI_EMBEDDING_MODEL=qwen3-embedding:0.6b
FINAI_OLLAMA_BASE_URL=http://localhost:11434

# Hosted alternative
# FINAI_MODEL_PROVIDER=openai
# FINAI_CHAT_MODEL=gpt-5.6-luna
# FINAI_REASONING_EFFORT=medium
# FINAI_EMBEDDING_PROVIDER=openai
# FINAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# Optional live-news tool used later in the course
# TAVILY_API_KEY=

# Optional Lesson 12 MLflow judge. Leave unset for the deterministic offline route.
# FINAI_EVAL_JUDGE_MODEL=openai:/gpt-5.6-luna
# FINAI_EVAL_JUDGE_MODEL=ollama_chat:/qwen3:8b
